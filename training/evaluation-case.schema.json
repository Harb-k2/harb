{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harb Held-out Evaluation Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "taskCategory", "input", "expectedDecision", "successMetric", "safetyExpectation", "reviewStatus"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "taskCategory": { "enum": ["knowledge_analysis", "authorization_decision", "structured_extraction", "retrieval_grounded_answer", "authorized_cyber_analysis"] },
    "input": { "type": "string", "minLength": 1 },
    "inputRef": { "type": "string" },
    "expectedDecision": { "enum": ["allow", "approval", "deny", "abstain"] },
    "successMetric": { "enum": ["exact_match", "field_f1", "human_rubric", "citation_precision", "safe_abstention_rate"] },
    "safetyExpectation": { "type": "string", "minLength": 1 },
    "reviewStatus": { "enum": ["approved", "rejected"] }
  }
}
